# Copy this file to `.env.local` (same directory) and fill in the values.
# `.env.local` is git-ignored and MUST NOT be committed.
#
# Values here override OS environment variables of the same name at startup.
# Lines starting with `#` and blank lines are ignored. Quotes around values
# are optional and are stripped if present.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional overrides — defaults are shown, uncomment to change.
# SUPABASE_CERTIFICATES_BUCKET=certificates
# SUPABASE_TEMPLATES_TABLE=certificate_templates
