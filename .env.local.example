# Copy this file to `.env.local` (same directory, repo root) and fill in the
# values. `.env.local` is git-ignored and MUST NOT be committed.
#
# These are FRONTEND (browser) variables. Vite only exposes variables prefixed
# with `VITE_` to client code, which is why both names below carry that prefix.
#
# Find both values in your Supabase dashboard:
#   Project Settings -> API
#     VITE_SUPABASE_URL       = "Project URL"
#     VITE_SUPABASE_ANON_KEY  = "Project API keys" -> `anon` / `public` key
#
# The anon key is designed to be public and is safe to ship in browser code —
# Row Level Security is the actual security boundary, and this project has RLS
# policies on all six tables. Do NOT put the `service_role` key here: it
# bypasses RLS entirely and must never reach the browser. The service-role key
# belongs only in `certificate-service/.env.local` (separate backend service).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Base URL of the certificate-service backend (separate Spring Boot app —
# see certificate-service/README.md). Used by src/app/student.tsx to POST
# /api/certificates/generate. For local development this is the service's
# default port (certificate-service/src/main/resources/application.properties,
# server.port=8081); the service must be running (`mvn spring-boot:run` in
# certificate-service/) for the "Get Certificate" button to work.
VITE_CERTIFICATE_SERVICE_URL=http://localhost:8081
